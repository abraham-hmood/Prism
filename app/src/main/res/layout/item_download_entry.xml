<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the browser's Downloads list: a downloaded file, or a site downloaded for the mesh.
     The remove button is gone until the row is long-pressed, so a destructive action is never one
     stray tap away while the user is just browsing the list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="12dp"
    android:paddingEnd="4dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/entryIcon"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="📄"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/entryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:text="file.zip"
            android:textColor="@color/prism_text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/entrySubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="middle"
            android:singleLine="true"
            android:text="example.com"
            android:textColor="@color/prism_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/entryRemove"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Remove this download"
        android:padding="9dp"
        android:src="@drawable/ic_close_24"
        android:visibility="gone"
        app:tint="@color/prism_destructive" />
</LinearLayout>
