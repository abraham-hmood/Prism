<?xml version="1.0" encoding="utf-8"?>
<!--
    FITS SYSTEM WINDOWS, which is the whole of the "it does not fit the screen" fix. Without it the
    title sat under the status bar and the last row of the list ran beneath the gesture bar, so the
    page was taller than the space it had. Every other full-page layout here (page_desktop_root)
    already declares it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/prismBackground"
    android:fitsSystemWindows="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <TextView
        android:id="@+id/modelsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.9"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="AI Models"
        android:textColor="@color/white"
        android:textSize="22sp" />

    <!--
        Collapsible sections, the way a VS Code sidebar stacks EXPLORER over SEARCH: every section
        header stays visible and the open one takes the room that is left.

        An accordion rather than independent toggles because both bodies want the whole remaining
        height. Two open at once would mean splitting it, which leaves neither list tall enough to be
        useful on a phone. A collapsed body is GONE, so its layout_weight stops counting and the open
        one expands into the space with no arithmetic anywhere.
    -->
    <LinearLayout
        android:id="@+id/sectionModelsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/chevronModels"
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="▾"
            android:textColor="@color/prism_text_muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:text="MODELS"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/modelsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/prism_text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/modelsEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:text="No models imported yet. Import one from Settings → Local AI Model."
        android:textColor="@color/prism_text_muted"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/modelsRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp" />

    <LinearLayout
        android:id="@+id/sectionQuantHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/chevronQuant"
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="▸"
            android:textColor="@color/prism_text_muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:text="QUANT"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shrink a model"
            android:textColor="@color/prism_text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/modelsQuantContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />
</LinearLayout>
