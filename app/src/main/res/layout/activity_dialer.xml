<?xml version="1.0" encoding="utf-8"?>
<!--
    The Prism keypad, modelled on the iOS Phone keypad.

    The screen is black whatever the app theme is, because that is what a phone keypad looks
    like on iOS and because a bright keypad at night is the opposite of a phone app. The typeface
    is forced to the system sans in DialerActivity: Prism's decorative font is an app-wide
    identity, but a keypad is a piece of hardware to the person using it, and its digits must
    stay unambiguous.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── Top bar: back, centred title, recordings ───────────────────── -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/dialerBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_back_24"
                android:tint="#FF0A84FF" />

            <TextView
                android:id="@+id/dialerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif"
                android:text="Keypad"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/dialerRecordings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Call recordings"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_call_record_24"
                android:tint="#FF0A84FF" />
        </FrameLayout>

        <!-- Shown only while Android still routes calls to another phone app. -->
        <TextView
            android:id="@+id/dialerRoleBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:padding="10dp"
            android:text="Make Prism your phone app to take and make calls here  ›"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- ── Keypad ─────────────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/dialerKeypadPane"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/dialerNumber"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="48dp"
                    android:layout_marginEnd="48dp"
                    android:ellipsize="start"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="38sp" />

                <ImageButton
                    android:id="@+id/dialerBackspace"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Delete"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_backspace_24"
                    android:tint="#FF8E8E93"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/dialerPlanHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/dialerKeypad"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="96dp">

                <ImageButton
                    android:id="@+id/dialerCall"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_call_answer"
                    android:contentDescription="Call"
                    android:padding="20dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_call_phone_24"
                    android:tint="#FFFFFFFF" />
            </FrameLayout>
        </LinearLayout>

        <!-- ── Mesh ───────────────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/dialerMeshPane"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/dialerMeshHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="14dp"
                android:textSize="13sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/dialerMeshList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/dialerMeshvoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="22dp"
                android:text="Meshvoice and voicemail  ›"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ── Bottom bar ─────────────────────────────────────────────────── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FF1C1C1E" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#FF0B0B0D"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dialerNavKeypad"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_dialpad_24"
                android:drawablePadding="3dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:paddingTop="7dp"
                android:text="Keypad"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/dialerNavMesh"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_mesh_24"
                android:drawablePadding="3dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:paddingTop="7dp"
                android:text="Mesh"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/dialerNavRecordings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_call_record_24"
                android:drawablePadding="3dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:paddingTop="7dp"
                android:text="Recordings"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
