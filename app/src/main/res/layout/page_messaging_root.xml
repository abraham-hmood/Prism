<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/prismBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Messages"
            android:textColor="?attr/prismTextPrimary"
            android:textSize="34sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif" />
    </RelativeLayout>

    <!-- Messaging Search Box (iOS-style flat pill, no glow) -->
    <FrameLayout
        android:id="@+id/messagingSearchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="4dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/messagingSearchLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxBackgroundColor="?attr/prismDivider"
            app:boxCornerRadiusBottomEnd="20dp"
            app:boxCornerRadiusBottomStart="20dp"
            app:boxCornerRadiusTopEnd="20dp"
            app:boxCornerRadiusTopStart="20dp"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/ic_search_24"
            app:startIconTint="?attr/prismTextSecondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/messagingSearchInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Search"
                android:inputType="text"
                android:paddingVertical="10dp"
                android:textColor="?attr/prismTextPrimary"
                android:textColorHint="?attr/prismTextSecondary"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messagingConversationList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="96dp" />

        <!--
            BOTTOM-ANCHORED, NOT CENTRED. A centred button sat on top of the conversation rows
            while the permission was missing, so the first conversations were unreadable and taps
            landed on the button instead of the thread. Bottom gravity plus the list's bottom
            padding keeps it clear of both the rows and the navigation bar.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/messagingRequestPermissionBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:elevation="4dp"
            android:text="Grant Permissions"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
