<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">


    <FrameLayout
        android:id="@+id/deleteZoneContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <com.prism.launcher.DeleteZoneView
            android:id="@+id/deleteZone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="center_horizontal"
            android:visibility="invisible" />

    </FrameLayout>

    <!-- The icon grid and the widget layer occupy the same space.

         Widgets are drawn on top rather than inside because a GridLayoutManager can span columns but
         not rows, so a 2x2 widget cannot be a grid item at all. The grid still owns which cells are
         taken — see DesktopWidgetLayer for why that split rather than a custom cell layout. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/desktopGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />

        <FrameLayout
            android:id="@+id/widgetLayerHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/hotseatContainer"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginBottom="24dp"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/hotseat_glass_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:clipChildren="false"/>
</LinearLayout>
