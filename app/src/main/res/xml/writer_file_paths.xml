<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the GIF cache is shared, and only that.
  A FileProvider grants another app read access to whatever these paths cover, so this is scoped to
  the one directory the keyboard writes GIFs into rather than to cache-path as a whole.
-->
<paths>
    <cache-path name="writer_gifs" path="writer-gifs/" />
    <!-- Where the camera writes a Lyke recording before it is imported. -->
    <cache-path name="lyke_capture" path="lyke-capture/" />
    <!-- Downloads opened from the browser's own list. DownloadManager's content URI is preferred;
         this is the fallback when the row has aged out of its database. -->
    <external-path name="downloads" path="Download/" />
    <!-- Packages received by the Prism Debug Bridge. Only this directory is exposed so Android's
         installer can read one file, never the app's private data. -->
    <files-path name="pdb_incoming" path="pdb/incoming/" />
    <!-- A Prism update after it passes quarantine. Without this entry the FileProvider refused the
         URI and the install button did nothing, which is exactly the kind of silent failure a
         security check must not have. Scoped to the downloads Prism itself wrote. -->
    <cache-path name="updates" path="updates/" />
    <!-- A package just downloaded by the App Store, handed to Android's installer. Only that
         folder is exposed: the store's other cache files are not the installer's business. -->
    <cache-path name="appstore" path="appstore/" />
    <!-- A file opened from a USB drive Prism reads itself (NTFS, ext4...): it is copied here first,
         because no other app can read the drive, and only this folder is shared. -->
    <cache-path name="usb_drive" path="usb-drive/" />
    <!--
        Finished VideoCraft films. They are written to Prism/VideoCraft/ in shared storage (see
        VideoCraftStore.root), so they need an <external-path> entry: a FileProvider cannot grant
        a path it has no root for. Without this, getUriForFile threw, the intent fell back to a
        file:// URI, and Android 7+ refused to open the film in any player. Scoped to the one
        folder the films live in, not to Prism/ as a whole.
    -->
    <external-path name="videocraft_films" path="Prism/VideoCraft/" />
</paths>
