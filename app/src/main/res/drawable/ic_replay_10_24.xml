<?xml version="1.0" encoding="utf-8"?>
<!--
  Seek back ten seconds: an anticlockwise arrow around a "10".

  The ring is an open stroke rather than a filled disc so the digits stay legible at 24dp, and the
  arrowhead sits on the arc's endpoint instead of beside it. A head floating away from a curve is
  the thing that makes an icon look hand-drawn.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M12,4.6 A7.4,7.4 0 1,1 4.6,12"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4.6,8.3 L2.5,12 L6.7,12 Z" />
    <path
        android:pathData="M10.1,13.6 L11.2,12.9 L11.2,17.4"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent" />
    <path
        android:pathData="M16,12.9 A2,2.2 0 1,1 15.99,12.9"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.2"
        android:fillColor="@android:color/transparent" />
</vector>
