# Toolchain for the one BUILD-MACHINE program ggml-vulkan needs: vulkan-shaders-gen.
#
# ggml-vulkan's own CMakeLists configures this sub-build itself, but it finds the compiler by
# looking for cl/gcc/clang on PATH -- and Gradle does not put one there. This file (generated by
# vulkan.cmake with a compiler that CMake has already proven can link a program) names it
# explicitly. Everything else about the sub-build is left to upstream, so this stays a two-line
# file that cannot drift from what ggml-vulkan expects.
#
# The generator is a host program -- it runs here, on the build machine, not on the phone -- so it
# must NOT be given the NDK's cross toolchain. Only the compiler is set; the target platform is
# whatever the host is, which is why no CMAKE_SYSTEM_NAME is set here.

set(CMAKE_C_COMPILER "@PRISM_VULKAN_HOST_CC@")
set(CMAKE_CXX_COMPILER "@PRISM_VULKAN_HOST_CXX@")

# CMake's Windows-Clang support enables the RC language, and the resource tools live in the Windows
# SDK — on PATH only inside a Visual Studio developer prompt. LLVM's own llvm-rc is a drop-in, and it
# is what this line points at when the detection above found it next to clang++.
if (NOT "@PRISM_VULKAN_HOST_RC@" STREQUAL "")
    set(CMAKE_RC_COMPILER "@PRISM_VULKAN_HOST_RC@")
endif()

# The generator is a small one-shot tool; a build of it that optimizes for size or debug info
# instead of speed is only ever slower. Release is what upstream's own template uses.
set(CMAKE_BUILD_TYPE Release)
set(CMAKE_C_FLAGS_RELEASE "-O2")
set(CMAKE_CXX_FLAGS_RELEASE "-O2")

# find_program() inside the sub-build must search the host, not the NDK sysroot that the outer
# configure has already put in CMAKE_FIND_ROOT_PATH.
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE NEVER)
